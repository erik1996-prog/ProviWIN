# SGS - Plantilla de variables de entorno.
# Copie este archivo como .env (nunca suba el .env real al repositorio).
# Las variables definidas en el servidor (SetEnv / sistema) tienen prioridad sobre este archivo.

APP_ENV=development            # development | testing | production
APP_ASSET_VERSION=              # opcional: fuerza recarga de CSS/JS

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=win_telecom_db
DB_USER=
DB_PASSWORD=

# Carpeta del sistema de origen donde viven uploads/ (fotos, firmas, avatares)
SHARED_FILES_PATH=C:/xampp/htdocs/SISTEMA-WIN-PROVINCIA

# Días que se conservan los archivos de 08_LOGS (mínimo 7)
SGS_LOG_RETENTION_DAYS=90

# Python para el reporte PDF de observaciones (requiere reportlab)
PYTHON_BIN=
